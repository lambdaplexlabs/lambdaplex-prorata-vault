# Copy this file to .env and replace the commented placeholders you need:
#
#   cp .env.example .env
#
# Never commit .env or real private keys.

# -----------------------------------------------------------------------------
# Local Hardhat unit tests
# -----------------------------------------------------------------------------
# `npx hardhat test test/PLEXVaultTest.spec.ts` uses Hardhat's built-in accounts
# and requires no environment variables.

# -----------------------------------------------------------------------------
# Hedera testnet signer (required for a real testnet deployment)
# -----------------------------------------------------------------------------
# Use the 32-byte ECDSA private key for the account paying for deployment.
# TESTNET_MYPRIVATEKEY=0xREPLACE_WITH_TESTNET_ECDSA_PRIVATE_KEY

# Optional account ID used only by the legacy config.ts helper.
# TESTNET_MYACCOUNTID=0.0.REPLACE_WITH_ACCOUNT_ID

# -----------------------------------------------------------------------------
# Vault deployment addresses (required by deploy/deployVaultToTestnet.ts)
# -----------------------------------------------------------------------------
# Use 20-byte EVM/Solidity addresses, not 0.0.x account or token IDs.
# Use the zero address for BASE or QUOTE only when that side is native HBAR.
# VAULT_BASE_ADDRESS=0xREPLACE_WITH_BASE_EVM_ADDRESS
# VAULT_QUOTE_ADDRESS=0xREPLACE_WITH_QUOTE_EVM_ADDRESS
# VAULT_DISTRIBUTOR_ADDRESS=0xREPLACE_WITH_DISTRIBUTOR_EVM_ADDRESS

# Optional. Defaults to the testnet deployer address when omitted.
# VAULT_MANAGER_ADDRESS=0xREPLACE_WITH_MANAGER_EVM_ADDRESS

# -----------------------------------------------------------------------------
# Optional vault parameters and their defaults
# -----------------------------------------------------------------------------
VAULT_OWNER_FEE_BIPS=0
VAULT_VESTING_SECS=604800
VAULT_LOCKUP_SECS=86400
VAULT_FEE_CHANGE_DELAY_SECS=604800

# Safe default: validate and print configuration without broadcasting.
# Change to false or remove it when you intentionally want to deploy.
DRY_RUN=true

# -----------------------------------------------------------------------------
# Optional legacy config.ts accounts (not needed by normal Hardhat tests)
# -----------------------------------------------------------------------------
# LOCAL_MYACCOUNTID=0.0.REPLACE_WITH_LOCAL_ACCOUNT_ID
# LOCAL_MYPRIVATEKEY=0xREPLACE_WITH_LOCAL_PRIVATE_KEY
# LOCAL_FEE_ID=0.0.REPLACE_WITH_LOCAL_FEE_ACCOUNT_ID
# LOCAL_FEE_PRIVATEKEY=0xREPLACE_WITH_LOCAL_FEE_PRIVATE_KEY

# TESTNET_ALICE_ID=0.0.REPLACE_WITH_TESTNET_ALICE_ID
# TESTNET_ALICE_PRIVATEKEY=0xREPLACE_WITH_TESTNET_ALICE_PRIVATE_KEY

# PREVNET_MYACCOUNTID=0.0.REPLACE_WITH_PREVIEWNET_ACCOUNT_ID
# PREVNET_MYPRIVATEKEY=0xREPLACE_WITH_PREVIEWNET_PRIVATE_KEY
# PREVNET_ALICE_ID=0.0.REPLACE_WITH_PREVIEWNET_ALICE_ID
# PREVNET_ALICE_PRIVATEKEY=0xREPLACE_WITH_PREVIEWNET_ALICE_PRIVATE_KEY
